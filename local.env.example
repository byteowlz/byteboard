# Copy to local.env (gitignored) and fill in. Read by relay-install.sh and the justfile.
# Each value can also be set in the environment.

# ssh host of a Mac the phone is plugged into, used when the phone is not reachable directly
BB_RELAY=
# xcrun devicectl list devices -> Identifier
BB_DEVICE_ID=
# security find-identity -v -p codesigning -> SHA-1 of an Apple Development identity
BB_SIGN_IDENTITY=
# UUIDs of the development profiles for the app and the keyboard extension
BB_APP_PROFILE_UUID=
BB_EXT_PROFILE_UUID=
# Apple developer team ID
BB_TEAM=
